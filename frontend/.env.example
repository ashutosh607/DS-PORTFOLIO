# Frontend Environment Configuration Template
# Copy this file to .env for local development
# For production (Vercel), add these variables in your Vercel Project Settings > Environment Variables

# Backend API Base URL (Leave empty for local development to use Vite proxy; Set to Render URL on Vercel, e.g., https://your-backend.onrender.com)
VITE_API_URL=

# Google Maps JavaScript API Key (for Location Map Picker)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Public Contact Information
VITE_STUDIO_EMAIL=contact@dsphotography.com
VITE_WHATSAPP_PHONE=919029736973
