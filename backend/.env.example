# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net
DB_NAME=ds_portfolio

# Security & Authentication (minimum 32 random characters)
JWT_SECRET=generate_a_random_32_character_secret_key_here

# Administrator Initial Credentials
ADMIN_EMAIL=admin@dsphotography.com
ADMIN_PASSWORD=your_super_secure_password_here

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Whitelist (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,https://yourdomain.com

# Rate Limiting Configuration (requests per 15-minute window)
GLOBAL_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
