# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net
DB_NAME=ds_portfolio

# Security & Authentication (minimum 32 random characters)
JWT_SECRET=generate_a_random_32_character_secret_key_here

# Administrator Initial Credentials (synced to MongoDB on startup)
ADMIN_EMAIL=admin@dsphotography.com
ADMIN_PASSWORD=your_super_secure_admin_password_here

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL & CORS Whitelist (add your Vercel frontend URL here)
FRONTEND_URL=https://your-portfolio.vercel.app
CORS_ORIGIN=http://localhost:5173,https://your-portfolio.vercel.app

# Automated Inquiry Email Notifications (Optional Nodemailer / Gmail App Password)
STUDIO_RECIPIENT_EMAIL=your_studio_email@example.com
EMAIL_USER=your_sender_email@gmail.com
EMAIL_PASS=your_16_character_google_app_password

# Rate Limiting Configuration (requests per 15-minute window)
GLOBAL_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
